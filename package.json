{
  "name": "zentro",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "turbo run dev --ui=tui",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test:smoke": "pnpm build && node --test scripts/smoke.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "infra:up": "docker compose -f compose.dev.yaml -p zentro-local up --wait --wait-timeout 60",
    "infra:down": "docker compose -f compose.dev.yaml -p zentro-local down",
    "infra:status": "docker compose -f compose.dev.yaml -p zentro-local ps",
    "infra:check": "node scripts/infra-check.mjs",
    "test": "turbo run test",
    "test:api": "turbo run test:api --filter=@repo/api",
    "test:infra:up": "docker compose -f compose.test.yaml -p zentro-test up --wait --wait-timeout 60",
    "test:infra:down": "docker compose -f compose.test.yaml -p zentro-test down",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "prepare": "husky",
    "check:staged": "lint-staged --concurrent false",
    "test:hooks": "node --test scripts/hooks.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "next": "16.4.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{js,jsx,mjs,cjs,ts,tsx}": "eslint --max-warnings=0 --no-warn-ignored"
  }
}
