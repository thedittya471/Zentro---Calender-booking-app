{
  "name": "zentro",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "engines": {
    "node": ">=24 <27"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "test:smoke": "pnpm build && node --test scripts/smoke.test.mjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "infra:up": "docker compose -f compose.dev.yaml -p zentro-local up --wait --wait-timeout 60",
    "infra:down": "docker compose -f compose.dev.yaml -p zentro-local down",
    "infra:status": "docker compose -f compose.dev.yaml -p zentro-local ps",
    "infra:check": "node scripts/infra-check.mjs",
    "test": "pnpm --filter @repo/api test",
    "test:api": "pnpm --filter @repo/api test:api",
    "test:infra:up": "docker compose -f compose.test.yaml -p zentro-test up --wait --wait-timeout 60",
    "test:infra:down": "docker compose -f compose.test.yaml -p zentro-test down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "next": "16.4.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  }
}
