{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "passThroughEnv": ["NODE_ENV", "API_HOST", "API_PORT"],
      "cache": false,
      "persistent": true
    }
  }
}
