# Local development only. Never reuse these sample credentials in production.
# API runtime settings: export these in your shell; Compose does not load them into apps.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001

POSTGRES_USER=zentro
POSTGRES_PASSWORD=dev_only
POSTGRES_DB=zentro
POSTGRES_PORT=5432
REDIS_PASSWORD=redis_dev_only
REDIS_PORT=6379

# Intended server connections; application configuration is not wired yet.
DATABASE_URL=postgresql://zentro:dev_only@127.0.0.1:5432/zentro
REDIS_URL=redis://:redis_dev_only@127.0.0.1:6379
