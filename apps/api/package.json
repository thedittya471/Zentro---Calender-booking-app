{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --include \"../../packages/db/dist/**/*.js\" src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=10000 test/api.test.mjs test/config.test.mjs test/database.test.mjs",
    "test:api": "node --import tsx --test --test-timeout=10000 test/api.test.mjs test/config.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "@repo/db": "workspace:*"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "pg": "8.23.1"
  }
}
